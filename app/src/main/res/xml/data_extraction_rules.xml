<?xml version="1.0" encoding="utf-8"?>
<!-- Progress, settings and the workspace travel with Android backup and device transfer; the shared picture cache does not. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="alchemy_progress.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="alchemy_progress.xml" />
    </device-transfer>
</data-extraction-rules>
